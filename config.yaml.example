# DIVE — Configuration Template
#
# Copy this file to config.yaml and fill in your values:
#   cp config.yaml.example config.yaml
#   chmod 600 config.yaml       # restrict read access to your user only
#
# config.yaml is gitignored and must never be committed.
# The app checks file permissions at startup and warns if config.yaml is world-readable.
#
# Secrets (this file): GitHub token, dashboard password, webhook URLs, SMTP credentials, NVD key.
# Preferences (dashboard UI): RSS feeds, keywords, schedule, model, feature toggles.

# ------------------------------------------------------------------
# GitHub
# ------------------------------------------------------------------
github:
  # Personal Access Token used for BOTH the dependency scanner and the
  # secrets scanner (which clones repos over HTTPS using this same token).
  #
  # Fine-grained token (recommended):
  #   Generate at: github.com → Settings → Developer settings → Fine-grained tokens
  #   Required permissions: Contents (Read-only), Metadata (Read-only)
  #   Repository access: you must explicitly select "All repositories", or
  #   individually select every private repo you want scanned — a
  #   fine-grained token only enumerates repos it's been granted access to,
  #   so private repos left unselected are silently skipped by both scanners.
  #   Set a 90-day expiration and rotate before it expires.
  #
  # Classic token (alternative): needs the `repo` scope for private repo
  # access (public_repo alone will not see private repos or let the secrets
  # scanner clone them).
  #
  # Either way, both scanners cover public AND private repos owned by this
  # token's account (not organizations — see docs/setup.md).
  token: ""

  # Your GitHub username — used to scope repository listing.
  username: ""

# ------------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------------
dashboard:
  # HTTP Basic Auth credentials for the web UI.
  # Choose a strong password — the dashboard is accessible to anyone on your network.
  username: "admin"
  password: ""

# ------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------
ollama:
  # Where the app connects to Ollama.
  # Docker (default): leave as-is — 'ollama' resolves to the Ollama container.
  # Bare-metal: change to http://127.0.0.1:11434
  host: "http://ollama:11434"

  # AI model used for news categorization and next-steps generation.
  # See docs/models.md for all supported options and how to switch models.
  model: "qwen2.5:3b"

# ------------------------------------------------------------------
# NIST NVD (optional but recommended)
# ------------------------------------------------------------------
nvd:
  # Free API key from nvd.nist.gov.
  # Without a key: 5 requests per 30 seconds (slower but functional).
  # With a key:   50 requests per 30 seconds.
  # Leave blank to run without a key.
  api_key: ""

# ------------------------------------------------------------------
# Notifications
# ------------------------------------------------------------------
# At least one method (Slack, Discord, or email) is required to receive alerts.
# Leave unused sections blank — the app skips unconfigured channels.

notifications:
  slack:
    # Incoming webhook URL from api.slack.com/apps
    # Format: https://hooks.slack.com/services/...
    webhook_url: ""

  discord:
    # Webhook URL from channel settings → Integrations → Webhooks
    # Format: https://discord.com/api/webhooks/...
    webhook_url: ""

  email:
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    # Your Gmail address
    username: ""
    # Gmail App Password (16 characters, not your regular Gmail password)
    # Generate at: myaccount.google.com/security → App passwords
    password: ""
    # Address shown in the From field
    from_address: ""
    # Address where alerts are delivered
    to_address: ""
